DISCORD_BOT_TOKEN=replace-with-your-bot-token
DISCORD_CHANNEL_ID=replace-with-your-channel-id
DISCORD_SCAN_USER_ID=replace-with-your-discord-user-id

# Optional: makes slash commands appear faster while testing in one server.
DISCORD_GUILD_ID=

# Optional when running without docker compose.
# The docker-compose service overrides these paths to /data.
# NAMELIST_DATA_PATH=bot-data.json
# NAMELIST_OUTPUT_PATH=namelist.json
